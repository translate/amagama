[Unit]
Description=Old amagama API (no web UI)

[Service]
ExecStart=/usr/bin/uwsgi \
        --ini /srv/amagama/uwsgi.ini \
        --socket /run/amagama/uwsgi.socket
RuntimeDirectory=amagama
User=www-data
Group=www-data
Restart=on-failure
KillSignal=SIGQUIT
Type=notify
StandardError=append:/srv/amagama/logs/uwsgi.log
NotifyAccess=all

[Install]
WantedBy=multi-user.target
