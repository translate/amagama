[Unit]
Description=Rebuild amaGama from its fetch cache and swap it in
Documentation=https://docs.translatehouse.org/projects/amagama/en/latest/managing.html#update
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=amagama
Group=amagama
Environment=AMAGAMA_CONFIG=/var/www/sites/amagama_fw/updater_settings.py
# Not while a fetch is running: skipped (75) rather than failed.
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 75 \
        /var/www/sites/amagama_fw/cache/.lock \
        /var/www/sites/amagama_fw/env3/bin/amagama-manage update -s en
SuccessExitStatus=75
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=24h
