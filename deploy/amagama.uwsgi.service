[Unit]
Description=amaGama web app and API

[Service]
ExecStart=/usr/bin/uwsgi \
        --ini /srv/amagama/uwsgi.ini \
        --socket /run/amagama/uwsgi.socket
RuntimeDirectory=amagama
User=www-data
Group=www-data
Restart=on-failure
KillSignal=SIGQUIT
# SIGHUP reloads the workers gracefully.
ExecReload=/bin/kill -HUP $MAINPID
Type=notify
StandardError=append:/srv/amagama/logs/uwsgi.log
NotifyAccess=all

[Install]
WantedBy=multi-user.target
