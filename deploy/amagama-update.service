[Unit]
Description=Rebuild amaGama from its fetch cache and swap it in
Documentation=https://docs.translatehouse.org/projects/amagama/en/latest/managing.html#update
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=amagama
Group=amagama
Environment=AMAGAMA_CONFIG=/srv/amagama/updater_settings.py
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=amagama-update
# The fetch timer keeps the cache current; this only rebuilds from it.
# Not while a fetch is running: skipped (75) rather than failed.
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 75 \
        /srv/amagama/cache/.lock \
        /srv/amagama/venv/bin/amagama-manage update -s en --no-fetch
SuccessExitStatus=75
# The web app caches block weights, licences and the source list per worker:
# reload it so a swapped-in rebuild is served whole. "+" runs it as root.
ExecStartPost=+/usr/bin/systemctl try-reload-or-restart amagama.uwsgi.service
Nice=10
IOSchedulingClass=idle
# Reclaim its own page cache, then slow down, before squeezing the web app.
MemoryHigh=1G
TimeoutStartSec=24h
