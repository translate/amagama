[Unit]
Description=Refresh amaGama's fetch cache from its translation sources
Documentation=https://docs.translatehouse.org/projects/amagama/en/latest/managing.html#fetch-sources
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=amagama
Group=amagama
Environment=AMAGAMA_CONFIG=/srv/amagama/updater_settings.py
# Not while an update is running: skipped (75) rather than failed.
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 75 \
        /srv/amagama/cache/.lock \
        /srv/amagama/venv/bin/amagama-manage fetch_sources
SuccessExitStatus=75
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=24h
