[Unit]
Description=Rebuild amaGama from its fetch cache and swap it in
Documentation=https://docs.translatehouse.org/projects/amagama/en/latest/managing.html#update
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=amagama
Group=amagama
Environment=AMAGAMA_CONFIG=/srv/amagama/updater_settings.py
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=amagama-update
# The fetch timer keeps the cache current; this only rebuilds from it.
# A fetch still running (Sunday's, or a catch-up after a reboot) is waited
# for; one still holding the lock after six hours fails the unit.
ExecStart=/usr/bin/flock --wait 21600 \
        /srv/amagama/cache/.lock \
        /srv/amagama/venv/bin/amagama-manage update -s en --no-fetch
# The web app caches block weights, licences and the source list per worker:
# reload it so a swapped-in rebuild is served whole. "+" runs it as root.
# ExecStopPost, as an update can fail after its swap (a full disk), and
# ExecStartPost runs only after a success.
ExecStopPost=+/usr/bin/systemctl try-reload-or-restart amagama.uwsgi.service
Nice=10
IOSchedulingClass=idle
# Reclaim its own page cache, then slow down, before squeezing the web app.
MemoryHigh=1G
# A rebuild of the full cache takes about two days (#3599 would shorten it).
TimeoutStartSec=96h
